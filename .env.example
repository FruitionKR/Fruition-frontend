# 로컬 개발용 API 주소(서버 전용, 브라우저에 노출되지 않음). AWS 이미지는 SAME_ORIGIN_API=true로 빌드해 이 값을 쓰지 않습니다.
ACCESS_URL=http://localhost:8081
BACKEND_URL=http://localhost:8080

# 서비스 접근 코드. 설정하면 이 코드를 입력한 브라우저만 전체 서비스를 사용할 수 있다. 비우면 게이트 비활성.
ACCESS_CODE=

# BACKEND_URL이 설정된 배포에서는 문서 API를 브라우저에서 해당 origin으로 직접 호출하고 PDF는 S3 multipart로 업로드한다.
# 직접 업로드만 끄려면 false로 설정한다. 비우면 BACKEND_URL 설정 여부를 따른다.
DOCUMENT_DIRECT_UPLOAD_ENABLED=

# 로그인 화면의 서버 기동 요청(/wake). 운영 Deployment에만 넣고 로컬에서는 비워 두면 기능이 꺼진다.
# ACCESS_CODE가 비어 있으면 아래 값을 채워도 /wake는 항상 403·{"phase":"unknown"}이다(봇 비용 방지). 운영에서는 ACCESS_CODE가 필수다.
# AWS 자격 증명(AWS_ROLE_ARN, AWS_WEB_IDENTITY_TOKEN_FILE)은 EKS IRSA가 주입하므로 여기 적지 않는다.
# AWS SDK가 쓰는 리전. 예: ap-northeast-2
AWS_REGION=
# 기동 요청 EventBridge 이벤트의 source·detail-type. 예: fruition.frontend / wake-requested
# 둘 중 하나라도 비우면 POST /wake가 이벤트를 보내지 않는다.
REQUEST_WAKE_EVENT_SOURCE=
REQUEST_WAKE_DETAIL_TYPE=
# 절전 상태를 담은 DynamoDB 테이블. 예: fruition-request-wake. 비우면 GET /wake가 항상 {"phase":"unknown"}을 준다.
REQUEST_WAKE_STATE_TABLE=
